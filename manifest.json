{
  "manifest_version": 3,
  "name": "说文 · LingoClarify",
  "version": "4.6.0",
  "description": "说文（LingoClarify）：网页划词翻译与语境解释、全文翻译、可拖动的 Markdown 结果浮层。自备 API Key，支持独立解释/翻译配置与自定义兼容接口。",
  "permissions": ["storage", "downloads", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selection.js", "vendor/marked/marked.umd.js", "vendor/dompurify/purify.min.js", "markdown.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_title": "说文 · LingoClarify",
    "default_popup": "popup.html"
  }
}

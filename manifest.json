{
  "manifest_version": 3,
  "name": "AI 智能解释 & 翻译",
  "version": "4.5.0",
  "description": "划词智能解释与全文流式翻译。支持 10 家厂家地址自动匹配、独立 API Key、接口开放模型自动更新及自定义兼容接口，Key 保存后收起。",
  "permissions": ["storage", "downloads", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selection.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_title": "AI 智能解释 & 翻译",
    "default_popup": "popup.html"
  }
}
